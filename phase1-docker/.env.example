# Copy to ".env" and change every password / secret. The real ".env" is git-ignored.
# Use only letters and digits in passwords: characters such as @ : / # break the
# MySQL DSN and the JDBC URL that are built from them.

# Where your clones of the course repositories live (relative to this folder)
AUTH_SRC=../../fum-cloud-notification-auth-2025
CORE_SRC=../../fum-cloud-notification-core-2025

# Optional image-registry prefix (keep the trailing slash), e.g. a mirror. Leave empty for Docker Hub.
REGISTRY=

# auth-db (MySQL)
AUTH_DB_ROOT_PASSWORD=ChangeMeRoot123
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=ChangeMeAuth123

# core-db (PostgreSQL)
CORE_DB_NAME=core_db
CORE_DB_USER=core_user
CORE_DB_PASSWORD=ChangeMeCore123
PROJECT_DATASOURCE_SCHEMA=public

# ActiveMQ admin account (also used by the core service)
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=ChangeMeMq123

# auth service
JWT_SECRET_KEY=ChangeMeLongRandomSecret0123456789

# Published ports (bound to 127.0.0.1 only)
AUTH_HTTP_PORT=8082
CORE_HTTP_PORT=8080
NODE_IP=localhost
